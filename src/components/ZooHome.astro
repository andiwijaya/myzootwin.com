---
import BaseLayout from '../layouts/BaseLayout.astro';
import {homeHabitatCards} from '../home-habitats';
import ZebraHomePreview from './ZebraHomePreview.astro';
const {locale = 'id'} = Astro.props;
const copy = locale === 'id' ? {
 title:'MyZooTwin — Bangun Zoo, Rawat Satwa, Jelajahi Empat Habitat',
 description:'Mainkan zoo 3D di browser. Rawat makaw, gajah, singa dan jerapah; bangun habitat, jalankan misi dan sambut pengunjung di MyZooTwin.',
 eyebrow:'Zoo kecilmu, cerita yang terus tumbuh', headline:'Rumah untuk satwa.', accent:'Dunia untuk dirawat.',
 intro:'Mulai dari aviary tropis. Rawat satwamu, sambut pengunjung, lalu kembangkan zoo hingga ke Giraffe Plains.',
 play:'Main Sekarang', explore:'Jelajahi habitat', details:'Langsung di browser · Tanpa akun', save:'Progres tersimpan di browser pada perangkat ini.',
 caption:'Pratinjau aktual V5 · Empat habitat tersedia; Zebra belum tersedia di versi publik.',
 heroAlt:'Pratinjau build V5 MyZooTwin: aviary makaw, habitat gajah, savana singa, jerapah dan Zebra di satu pulau. Zebra belum tersedia di versi publik.',
 habitatsLabel:'Kenali para penghuni', habitatsTitle:'Empat habitat untuk dimainkan. Satu kawanan berikutnya.',
 habitatsIntro:'Mulai bersama makaw, lalu buka Elephant Grove, Lion Savanna dan Giraffe Plains melalui progres serta misi. Kenali juga pratinjau Zebra Grasslands yang sedang disiapkan.',
 habitatStatus:{start:'Mulai di sini',progression:'Dibuka lewat progres',preview:'Pratinjau · Belum tersedia'},
 habitatsPlay:'Mainkan habitat yang tersedia',habitatsNote:'Permainan saat ini memuat empat habitat. Habitat lanjutan mengikuti progres dan misi; Zebra belum tersedia di versi publik.',
 featureLabel:'Sorotan habitat · Giraffe Plains', featureTitle:'Sudut pandang baru di zoo kamu.',
 featureIntro:'Dira, Sora dan Lila membawa kehidupan baru ke dataran. Tiga jerapah dewasa ini meraih daun tinggi, menunduk untuk minum dan berteduh untuk beristirahat.',
 featureText:'Siapkan kebutuhan dasar dan jalur pandang pengunjung. Selesaikan misi habitat sambil menjaga kesejahteraan kawanan.',
 featureAlt:'Tiga jerapah dewasa di Giraffe Plains, dengan tempat pakan daun tinggi, air dan pohon naungan di dalam pagar.',
 featureCaption:'Gameplay aktual · Kamera difokuskan ke Giraffe Plains',
 loopLabel:'Cara bermain', loopTitle:'Rawat hari ini. Tumbuhkan esok hari.',
 steps:[['Bangun rumahnya','Tempatkan habitat dan fasilitas, lalu sambungkan jalur dari pintu masuk.'],['Rawat satwanya','Isi pakan dan air. Perhatikan istirahat, pengayaan dan kesejahteraan setiap penghuni.'],['Jalankan misinya','Ikuti tujuan habitat dan ambil hadiah saat persyaratannya terpenuhi.'],['Sambut pengunjung','Buka pintu masuk dan kelola tiket virtual untuk membantu pengembangan zoo.']],
 startTitle:'Zoo pertamamu dimulai di sini.',startText:'Buka permainan, mulai petualangan baru atau lanjutkan progres yang tersimpan di browser ini.',journal:'Kenali dunia satwa',about:'Tentang MyZooTwin',
 faqTitle:'Sebelum mulai', faq:[['Apakah perlu mengunduh atau membuat akun?','Tidak. Permainan berjalan di browser tanpa akun. JavaScript dan browser yang mendukung WebGL diperlukan untuk bermain.'],['Apakah semua habitat langsung terbuka?','Perjalanan dimulai di Macaw Aviary. Perluasan Elephant Grove, Lion Savanna dan Giraffe Plains mengikuti progres serta misi zoo.'],['Di mana progres disimpan?','Progres disimpan lokal di profil browser ini saat penyimpanan tersedia. Tidak ada sinkronisasi antarperangkat. Menghapus data situs akan menghapus progres lokal.']]
} : {
 title:'MyZooTwin — Build a Zoo, Care for Animals, Explore Four Habitats',
 description:'Play a 3D zoo in your browser. Care for macaws, elephants, lions and giraffes; build habitats, complete missions and welcome visitors in MyZooTwin.',
 eyebrow:'Your little zoo, a growing story',headline:'A home for animals.',accent:'A world to care for.',
 intro:'Begin with a tropical aviary. Care for your animals, welcome visitors and grow your zoo all the way to Giraffe Plains.',
 play:'Play Now',explore:'Explore the habitats',details:'In your browser · No account needed',save:'Progress is saved in this browser on this device.',
 caption:'Actual V5 preview · Four habitats are available; Zebras are not in the public version yet.',
 heroAlt:'MyZooTwin V5 build preview showing macaw, elephant, lion, giraffe and Zebra habitats on one island. Zebras are not in the public version yet.',
 habitatsLabel:'Meet your neighbours',habitatsTitle:'Four habitats to play. A preview of the next herd.',habitatsIntro:'Start with macaws, then unlock Elephant Grove, Lion Savanna and Giraffe Plains through progress and missions. Meet the Zebra Grasslands preview being prepared for a future version.',
 habitatStatus:{start:'Start here',progression:'Unlocked through progress',preview:'Preview · Not available yet'},
 habitatsPlay:'Play the available habitats',habitatsNote:'The current game has four habitats. Later habitats follow progress and missions; Zebras are not available in the public version yet.',
 featureLabel:'Habitat spotlight · Giraffe Plains',featureTitle:'A new perspective on your zoo.',featureIntro:'Dira, Sora and Lila bring new life to the plains. These three adult giraffes reach for high leaves, lower their heads to drink and settle in the shade.',featureText:'Prepare their essentials and an outside viewing path. Complete habitat missions while looking after the herd’s welfare.',
 featureAlt:'Three adult giraffes in Giraffe Plains with high browse, water and a shade tree inside their fenced habitat.',featureCaption:'Actual gameplay · Camera focused on Giraffe Plains',
 loopLabel:'How to play',loopTitle:'Care today. Grow tomorrow.',steps:[['Build a home','Place habitats and facilities, then connect paths from the entrance.'],['Care for your animals','Refill food and water. Look after rest, enrichment and each resident’s welfare.'],['Follow the missions','Work towards habitat goals and claim rewards when their requirements are met.'],['Welcome visitors','Open the entrance and manage virtual tickets to help your zoo grow.']],
 startTitle:'Your first zoo starts here.',startText:'Open the game to begin a new adventure or continue progress saved in this browser.',journal:'Explore the animal journal',about:'About MyZooTwin',
 faqTitle:'Before you begin',faq:[['Do I need a download or an account?','No. Play in your browser without an account. JavaScript and a WebGL-capable browser are required to play.'],['Are all habitats open from the start?','Your journey starts at Macaw Aviary. Elephant Grove, Lion Savanna and Giraffe Plains unlock through zoo progress and missions.'],['Where is my progress saved?','Progress stays locally in this browser profile when storage is available. There is no cross-device sync. Clearing site data removes local progress.']]
};
const socialImage = {src:'/images/home/v5-zoo-social.jpg',alt:copy.heroAlt,width:1200,height:630};
const structuredData = {'@context':'https://schema.org','@type':'VideoGame',name:'MyZooTwin',url:'https://myzootwin.com/play/',description:copy.description,genre:'Simulation',gamePlatform:'Web browser',inLanguage:['id','en'],image:'https://myzootwin.com/images/home/v5-zoo-social.jpg'};
---
<BaseLayout gameHome locale={locale} title={copy.title} description={copy.description} socialImage={socialImage}>
 <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
 <section class="zoo-hero" aria-labelledby="game-title">
  <div class="hero-copy"><p class="eyebrow">{copy.eyebrow}</p><h1 id="game-title">{copy.headline}<br /><em>{copy.accent}</em></h1><p class="intro">{copy.intro}</p><div class="hero-actions"><a class="button" href="/play/" data-site-source="home">{copy.play}<span aria-hidden="true">↗</span></a><a class="text-link" href="#habitats">{copy.explore}<span aria-hidden="true">↓</span></a></div><p class="play-details">{copy.details}<br />{copy.save}</p></div>
  <figure class="hero-image"><img src="/images/home/v5-zoo-770.webp" srcset="/images/home/v5-zoo-480.webp 480w, /images/home/v5-zoo-770.webp 770w" sizes="(max-width: 900px) 92vw, 57vw" width="770" height="520" alt={copy.heroAlt} fetchpriority="high" /><figcaption>{copy.caption}</figcaption></figure>
 </section>
 <ZebraHomePreview locale={locale} />
 <section class="habitats section" id="habitats" aria-labelledby="habitats-title"><div class="section-heading"><p class="eyebrow">{copy.habitatsLabel}</p><h2 id="habitats-title">{copy.habitatsTitle}</h2><p>{copy.habitatsIntro}</p></div><div class="habitat-grid">{homeHabitatCards.map((habitat,i) => {
  const text=locale==='id'?habitat.idCopy:habitat.enCopy;
  return <article class:list={['habitat-card',`habitat-${i}`,{'habitat-preview':habitat.availability==='preview'}]} data-home-habitat={habitat.id} data-availability={habitat.availability} aria-labelledby={`habitat-${habitat.id}-title`}><span class="habitat-number" aria-hidden="true">0{i+1}</span><p class="habitat-status">{copy.habitatStatus[habitat.availability]}</p><p class="habitat-label">{text.label}</p><h3 id={`habitat-${habitat.id}-title`} lang="en">{habitat.name}</h3><p>{text.text}</p></article>;
 })}</div><div class="habitat-actions"><a class="button" href="/play/" data-site-source="home">{copy.habitatsPlay}<span aria-hidden="true">↗</span></a><p>{copy.habitatsNote}</p></div></section>
 <section class="spotlight section" aria-labelledby="spotlight-title"><figure><img src="/images/home/giraffes-800.webp" srcset="/images/home/giraffes-480.webp 480w, /images/home/giraffes-800.webp 800w" sizes="(max-width: 900px) 90vw, 48vw" width="800" height="640" alt={copy.featureAlt} loading="lazy" decoding="async" /><figcaption>{copy.featureCaption}</figcaption></figure><div class="spotlight-copy"><p class="eyebrow">{copy.featureLabel}</p><h2 id="spotlight-title">{copy.featureTitle}</h2><p class="intro">{copy.featureIntro}</p><p>{copy.featureText}</p><a class="text-link" href="/play/" data-site-source="home">{copy.play}<span aria-hidden="true">↗</span></a></div></section>
 <section class="section play-loop" aria-labelledby="loop-title"><div class="section-heading"><p class="eyebrow">{copy.loopLabel}</p><h2 id="loop-title">{copy.loopTitle}</h2></div><ol class="steps">{copy.steps.map(([title,text],i) => <li><span aria-hidden="true">0{i+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></section>
 <section class="section faq" aria-labelledby="faq-title"><h2 id="faq-title">{copy.faqTitle}</h2><div>{copy.faq.map(([question,answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
 <section class="start section" aria-labelledby="start-title"><p class="eyebrow">MyZooTwin</p><h2 id="start-title">{copy.startTitle}</h2><p>{copy.startText}</p><a class="button" href="/play/" data-site-source="home">{copy.play}<span aria-hidden="true">↗</span></a><div class="related-links"><a href="/animals/">{copy.journal}</a><a href="/about/">{copy.about}</a></div></section>
</BaseLayout>
<style>
.zoo-hero{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(1.5rem,3vw,3rem);align-items:center;padding:clamp(2rem,5vw,5rem) clamp(1.2rem,5vw,5rem);background:#edf2e7}.hero-copy{min-width:0;max-width:35rem}.hero-copy h1{font-size:clamp(2.8rem,4.4vw,4.9rem);line-height:1.08;margin:1rem 0 1.5rem}.hero-copy h1 em{font-style:normal;color:var(--forest)}.intro{font-size:1.08rem;line-height:1.7;color:#435d4f}.hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:1rem 1.5rem;margin:1.7rem 0 1.2rem}.button{min-height:48px}.text-link{display:inline-flex;align-items:center;min-height:44px;gap:.7rem;font-size:.9rem;font-weight:700;text-decoration:underline;text-underline-offset:5px}.play-details{font-size:.8rem;color:#4f6556;line-height:1.9}.hero-image{margin:0;min-width:0}.hero-image img{display:block;width:100%;height:auto;border-radius:20px;border:1px solid #b4c3a6;box-shadow:0 18px 40px #183b3214}figcaption{font-size:.75rem;line-height:1.5;color:#4f6556;margin:.65rem .3rem 0}.section{padding:clamp(3rem,6vw,5.5rem) clamp(1.2rem,5vw,5rem);scroll-margin-top:1.5rem}.section-heading{max-width:47rem;margin-bottom:2.3rem}.section h2{font-size:clamp(2rem,3.8vw,3.4rem);line-height:1.12}.section-heading>p:last-child{color:#435d4f;max-width:43rem;margin:1.1rem 0 0}.habitat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.habitat-card{min-width:0;border:1px solid #d3ddca;border-radius:18px;padding:1.6rem 1.3rem 1.2rem;background:#f1f5e9}.habitat-1{background:#eff1e7}.habitat-2{background:#f8efdc}.habitat-3{background:#f0edd9;border-color:#beac76}.habitat-number{display:block;color:#526844;font-size:1.8rem;font-family:Georgia,serif;margin-bottom:1.9rem}.habitat-label{font-size:.74rem;font-weight:600;line-height:1.6;margin:0 0 .5rem;color:#586348}.habitat-card h3{font-size:1.55rem;line-height:1.15;margin:0 0 1rem}.habitat-card>p:last-child{font-size:.88rem;color:#435744;line-height:1.75;margin:0}.spotlight{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);align-items:center;gap:clamp(2rem,5vw,5rem);background:#f1eedf}.spotlight figure{margin:0;min-width:0}.spotlight img{display:block;width:100%;height:auto;border-radius:18px;border:1px solid #c9c6ab}.spotlight-copy>p:not(.eyebrow){color:#435744}.spotlight-copy .text-link{margin-top:.5rem}.steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2rem;list-style:none;margin:0;padding:0}.steps li{border-top:1px solid #b7c5ac;padding-top:1rem}.steps li>span{font-size:.8rem;color:#637255}.steps h3{font-size:1.5rem;line-height:1.2;margin:1.4rem 0 .8rem}.steps p{font-size:.9rem;color:#435744;line-height:1.75;margin:0}.faq{display:grid;grid-template-columns:minmax(0,.65fr) minmax(0,1fr);gap:2rem;background:#f5f5ed}.faq details{border-bottom:1px solid #cbd5c3}.faq summary{font-weight:600;cursor:pointer;padding:1.1rem .3rem;min-height:48px}.faq summary:focus-visible{outline:3px solid var(--gold-text);outline-offset:3px}.faq details p{margin:0 .3rem 1.3rem;color:#435744;font-size:.9rem}.start{text-align:center;background:#e4ecda}.start h2{max-width:44rem;margin:auto}.start>p:not(.eyebrow){max-width:40rem;margin:1.2rem auto 1.6rem;color:#435744}.related-links{display:flex;justify-content:center;flex-wrap:wrap;gap:.5rem 2rem;margin-top:1.7rem;font-size:.85rem}.related-links a{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline;text-underline-offset:4px}
:global(body.game-home .site-header){height:auto;min-height:76px;gap:1rem;flex-wrap:wrap;padding-block:.75rem}:global(body.game-home .site-header nav){order:initial;width:auto;overflow:visible;padding:0;gap:clamp(.7rem,2vw,1.5rem);flex-wrap:wrap}:global(body.game-home .site-header nav a){display:inline-flex;align-items:center;min-height:44px}:global(body.game-home .site-header nav [aria-current="page"]){text-decoration:underline;text-underline-offset:5px}:global(body.game-home .site-footer){gap:2rem}:global(body.game-home .footer-links a){display:inline-flex;align-items:center;min-height:44px}
.habitat-status{display:inline-block;margin:0 0 .8rem;padding:.25rem .55rem;border:1px solid #b5c5ab;border-radius:6px;font-size:.72rem;font-weight:700;line-height:1.6;color:#28533d;background:#e7efdf}.habitat-preview{grid-column:1/-1;background:#edf0e7;border-style:dashed;border-color:#8c9b80}.habitat-preview .habitat-number{margin-bottom:.6rem}.habitat-preview .habitat-status{background:#f6f0dd;border-color:#bca876;color:#604c23}.habitat-preview>p:last-child{max-width:65ch}.habitat-actions{display:flex;align-items:center;flex-wrap:wrap;gap:1rem 1.5rem;margin-top:1.5rem}.habitat-actions p{max-width:40rem;margin:0;color:#435744;font-size:.9rem;line-height:1.7}
@media(max-width:1100px){.habitat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.habitat-number{margin-bottom:1rem}}
@media(max-width:900px){.zoo-hero{grid-template-columns:1fr;gap:2rem}.hero-copy{max-width:42rem}.hero-copy h1{font-size:clamp(2.8rem,7vw,4.7rem)}.hero-image{max-width:60rem}.spotlight{grid-template-columns:1fr}.spotlight figure{max-width:48rem}.steps{grid-template-columns:repeat(2,minmax(0,1fr))}.faq{grid-template-columns:1fr}}
@media(max-width:540px){.habitat-grid{grid-template-columns:1fr}.habitat-card{padding:1.3rem}.habitat-number{font-size:1.3rem;margin-bottom:.5rem}.steps{grid-template-columns:1fr;gap:1.5rem}.steps h3{margin:.7rem 0}.hero-copy h1{font-size:clamp(2.6rem,10.5vw,3.7rem)}:global(body.game-home .brand){font-size:1.05rem;gap:.4rem}:global(body.game-home .site-header){padding-inline:1.2rem}:global(body.game-home .site-header nav){font-size:.8rem}:global(body.game-home .site-footer small){white-space:normal}.hero-actions{gap:.5rem 1rem}.section-heading{margin-bottom:1.7rem}}
@media(prefers-reduced-motion:reduce){.button:hover{transform:none}}
</style>

---
import {homeHabitatCards} from '../home-habitats';
const {locale='id'}=Astro.props;
const zebra=homeHabitatCards.find(habitat=>habitat.id==='zebra');
if(!zebra||zebra.availability!=='progression')throw new Error('Zebra release promotion requires the verified progression habitat.');
const copy=locale==='id'?{
 label:'Dibuka setelah Giraffe Plains',title:'Empat Zebra. Kehidupan dalam kawanan.',
 imageAlt:'Empat Zebra di Zebra Grasslands, dalam habitat berpagar dengan pohon naungan, rumput dan bak air.',
 imageCaption:'Gameplay aktual · Kawanan Zebra Grasslands.',
 intro:'Kenali Zaki, Zuri, Mira dan Kira di Zebra Grasslands. Kebutuhan dasar, ruang gerak dan kegiatan kawanan saling berkaitan dalam perawatan mereka.',
 features:[
  ['Amati kawanan merumput dan minum','Isi stok pakan dan air, lalu sisakan jalan agar Zebra bisa mendekat dan benar-benar memakainya. Isi ulang menyiapkan persediaan, bukan langsung memenuhi kebutuhan.'],
  ['Ruang untuk bergerak dan berteduh','Sediakan naungan dan tanah bebas untuk berjalan. Beri kesempatan kawanan beristirahat sampai selesai saat mereka membutuhkannya.'],
  ['Saling merawat dalam kawanan','Saling merawat memerlukan dua Zebra yang bertemu. Debu dan batang pengayaan menambah kegiatan, tanpa menggantikan pakan, air atau istirahat.']
 ],play:'Mulai merawat zoo kamu',explore:'Jelajahi lima habitat',
 availability:'Mulai bersama makaw dan kembangkan zoo melalui misi. Selesaikan dan klaim GQ04 di Giraffe Plains, lalu klaim hibah Zebra satu kali untuk memulai pembangunan Zebra Grasslands. Jalur dan fasilitas dibeli terpisah.'
}:{
 label:'Unlocked after Giraffe Plains',title:'Four Zebras. Life with the herd.',
 imageAlt:'Four Zebras in Zebra Grasslands, inside a fenced habitat with shade trees, grass and a water bowl.',
 imageCaption:'Actual gameplay · The Zebra Grasslands herd.',
 intro:'Meet Zaki, Zuri, Mira and Kira in Zebra Grasslands. Basic needs, room to move and herd activities all play a part in their care.',
 features:[
  ['Watch the herd graze and drink','Refill feed and water, then leave clear routes so Zebras can reach and use them. Refills prepare supplies, rather than immediately satisfying needs.'],
  ['Room to move and rest in shade','Provide shade and clear ground for walking. Give the herd time to finish resting when they need it.'],
  ['Mutual grooming within the herd','Mutual grooming takes two Zebras meeting. Dust and scratch enrichment adds activities without replacing food, water or rest.']
 ],play:'Start caring for your zoo',explore:'Explore five habitats',
 availability:'Begin with macaws and grow your zoo through missions. Complete and claim GQ04 in Giraffe Plains, then claim the Zebra grant once to begin building Zebra Grasslands. Paths and facilities are purchased separately.'
};
---
<section class="zebra-preview" aria-labelledby="zebra-grasslands-title" data-zebra-home-spotlight data-availability={zebra.availability}>
 <div class="preview-copy"><p class="preview-status">{copy.label}</p><p class="eyebrow" lang="en">{zebra.name}</p><h2 id="zebra-grasslands-title">{copy.title}</h2><p class="preview-intro">{copy.intro}</p><figure><img src="/images/home/v5-zebra-660.webp" srcset="/images/home/v5-zebra-440.webp 440w, /images/home/v5-zebra-660.webp 660w" sizes="(max-width: 900px) 90vw, 44vw" width="660" height="460" alt={copy.imageAlt} loading="lazy" decoding="async" /><figcaption>{copy.imageCaption}</figcaption></figure></div>
 <ul class="preview-features">{copy.features.map(([title,text])=><li><h3>{title}</h3><p>{text}</p></li>)}</ul>
 <div class="preview-actions"><p id="zebra-progression-note">{copy.availability}</p><div><a class="button" href="/play/" data-site-source="home" aria-describedby="zebra-progression-note">{copy.play}<span aria-hidden="true">↗</span></a><a class="preview-link" href="#habitats">{copy.explore}<span aria-hidden="true">↓</span></a></div></div>
</section>
<style>
.preview-copy figure{margin:1.4rem 0 0}.preview-copy img{display:block;width:100%;height:auto;border:1px solid #acbca2;border-radius:16px}.preview-copy figcaption{font-size:.75rem;line-height:1.6;color:#435744;margin:.65rem .2rem 0}
.zebra-preview{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:2rem clamp(2rem,5vw,5rem);padding:clamp(3rem,6vw,5.5rem) clamp(1.2rem,5vw,5rem);background:#e9eee4;border-block:1px solid #c4d0ba}.preview-copy{min-width:0}.preview-status{display:inline-block;margin:0 0 1.25rem;padding:.35rem .7rem;background:#f8f1dc;border:1px solid #bca876;border-radius:6px;color:#604c23;font-size:.78rem;font-weight:700;line-height:1.6}.preview-copy .eyebrow{margin:0 0 1rem}.preview-copy h2{font-size:clamp(2.1rem,3.8vw,3.4rem);line-height:1.12;margin:0}.preview-intro{max-width:39rem;color:#435744;margin:1.3rem 0 0;line-height:1.75}.preview-features{list-style:none;margin:0;padding:0;min-width:0}.preview-features li{padding:1.1rem 0;border-top:1px solid #acbca2}.preview-features li:first-child{padding-top:0;border-top:0}.preview-features h3{font-size:1.45rem;line-height:1.22;margin:0 0 .7rem}.preview-features p{font-size:.92rem;line-height:1.75;color:#435744;margin:0}.preview-actions{grid-column:1/-1;min-width:0;border-top:1px solid #acbca2;padding-top:1.5rem}.preview-actions>p{max-width:65ch;font-size:.9rem;line-height:1.75;color:#435744;margin:0 0 1.2rem}.preview-actions>div{display:flex;align-items:center;flex-wrap:wrap;gap:.75rem 1.5rem}.preview-actions .button{min-height:48px;max-width:100%;white-space:normal}.preview-link{display:inline-flex;align-items:center;min-height:44px;gap:.7rem;font-size:.9rem;font-weight:700;text-decoration:underline;text-underline-offset:5px}
@media(max-width:900px){.zebra-preview{grid-template-columns:1fr;gap:1.8rem}.preview-features li:first-child{border-top:1px solid #acbca2;padding-top:1.1rem}}
</style>

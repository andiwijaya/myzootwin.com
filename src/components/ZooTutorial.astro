---
import BaseLayout from '../layouts/BaseLayout.astro';
import ZooTutorialSearch from './ZooTutorialSearch.astro';
import { tutorialCopy, type TutorialLocale } from '../tutorial/content';

interface Props {
  locale: TutorialLocale;
}

const { locale } = Astro.props;
const copy = tutorialCopy[locale];
const photos = import.meta.glob<string>('../assets/tutorial/*.webp', { eager: true, query: '?url', import: 'default' });
const devices = [
  { key: 'mobile', label: copy.mobile, width: 390, height: 844 },
  { key: 'desktop', label: copy.desktop, width: 1366, height: 768 },
] as const;
const socialImage = {
  src: photos['../assets/tutorial/camera-desktop.webp'],
  alt: locale === 'id' ? 'Lima habitat dalam peta MyZooTwin' : 'Five habitats on the MyZooTwin map',
  width: 1366,
  height: 768,
};
---
<BaseLayout gameGuide locale={locale} title={copy.title + ' — Tutorial'} description={copy.description} socialImage={socialImage}>
  <article class="guide" data-tutorial-page>
    <ZooTutorialSearch {locale} />
    <header class="guide-intro">
      <h1>{copy.title}</h1>
      <p>{copy.intro}</p>
      <a class="button" href="/play/" data-tutorial-play>{copy.play}<span aria-hidden="true">↗</span></a>
    </header>
    <nav class="guide-contents" aria-labelledby="guide-contents-title">
      <h2 id="guide-contents-title">{copy.contents}</h2>
      <ul>
        {copy.sections.map(section => <li><a href={'#' + section.id}>{section.title}</a></li>)}
      </ul>
      <p>{copy.imageNote}</p>
    </nav>
    {copy.sections.map(section => (
      <section id={section.id} class="guide-chapter" aria-labelledby={section.id + '-title'} data-tutorial-chapter data-search-terms={section.searchTerms} tabindex="-1">
        <div class="guide-copy">
          <h2 id={section.id + '-title'}>{section.title}</h2>
          <p class="guide-summary">{section.summary}</p>
          <ol class="guide-steps">
            {section.steps.map(([label, instruction]) => <li><strong>{label}</strong> {instruction}</li>)}
          </ol>
          {section.id === 'habitat' && (
            <dl class="guide-progression">
              {copy.progression.map(([habitat, unlock]) => <div><dt>{habitat}</dt><dd>{unlock}</dd></div>)}
            </dl>
          )}
          {section.note && <p class="guide-note">{section.note}</p>}
        </div>
        {section.screenshots && (
          <div class="guide-gallery">
            {devices.map(device => {
              const pair = section.screenshots!;
              const src = photos['../assets/tutorial/' + pair.name + '-' + device.key + '.webp'];
              if (!src) throw new Error('Missing tutorial screenshot for ' + pair.name + ' ' + device.key);
              return (
                <figure>
                  <figcaption>{device.label}</figcaption>
                  <a href={src} aria-label={copy.enlarge + ' · ' + device.label + ' · ' + section.title}>
                    <img src={src} width={device.width} height={device.height} alt={pair[device.key]}
                      loading="lazy" decoding="async" data-tutorial-screenshot={device.key} />
                  </a>
                </figure>
              );
            })}
          </div>
        )}
      </section>
    ))}
    <section class="guide-end" aria-labelledby="guide-end-title">
      <h2 id="guide-end-title">{copy.ready}</h2>
      <a class="button" href="/play/" data-tutorial-play>{copy.play}<span aria-hidden="true">↗</span></a>
    </section>
  </article>
</BaseLayout>

<style>
  .guide {
    max-width: 1170px;
    margin-inline: auto;
    padding: clamp(1rem, 4vw, 3.5rem);
  }
  .guide-intro {
    padding: clamp(1.5rem, 5vw, 4.2rem);
    border: 1px solid #d8e3d1;
    border-radius: 22px;
    background: #edf2e7;
  }
  .guide-intro h1 { font-size: clamp(2.35rem, 6.5vw, 4.6rem); line-height: 1.07; }
  .guide-intro p {
    max-width: 60ch;
    margin: 1.1rem 0 1.5rem;
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    color: #425e4e;
  }
  .guide .button { min-height: 48px; }
  .guide-contents {
    display: block;
    margin-block: 1.6rem 3rem;
    padding: clamp(1rem, 3vw, 1.8rem);
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #f7f8f1;
  }
  .guide-contents h2 { font-size: 1.5rem; }
  .guide-contents ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 205px), 1fr));
    list-style: none;
    gap: .35rem 1rem;
    padding: 0;
    margin: .65rem 0 .8rem;
  }
  .guide-contents a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    color: var(--forest);
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  .guide-contents p { margin: 0; font-size: .9rem; color: #425e4e; }
  .guide-chapter {
    margin-block-end: 3.2rem;
    padding-block-start: 1.7rem;
    border-top: 1px solid var(--line);
    scroll-margin-block-start: 1rem;
  }
  .guide-copy { max-width: 74ch; }
  .guide-chapter h2, .guide-end h2 { font-size: clamp(1.8rem, 4vw, 2.68rem); line-height: 1.13; }
  .guide-summary { margin: .7rem 0 1rem; font-size: 1.04rem; color: #425e4e; }
  .guide-steps { display: grid; gap: .7rem; padding-inline-start: 1.55rem; margin-block: 1rem; }
  .guide-steps li { padding-inline-start: .25rem; }
  .guide-steps li::marker { color: var(--forest); font-weight: 700; }
  .guide-note {
    margin: 1.1rem 0 0;
    padding: .75rem 1rem;
    border-inline-start: 3px solid #879d76;
    background: #f0f4eb;
  }
  .guide-progression { display: grid; margin: 1rem 0; }
  .guide-progression div {
    display: grid;
    grid-template-columns: minmax(116px, 1fr) minmax(0, 3fr);
    gap: .35rem .9rem;
    padding: .65rem .8rem;
    background: #f7f8f1;
    border-bottom: 1px solid var(--line);
  }
  .guide-progression dt { font-weight: 700; }
  .guide-progression dd { margin: 0; }
  .guide-gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.65fr);
    align-items: start;
    gap: clamp(.85rem, 2.25vw, 1.5rem);
    margin-block-start: 1.35rem;
  }
  .guide-gallery figure { margin: 0; min-width: 0; }
  .guide-gallery figcaption { margin: 0 0 .4rem; font-weight: 700; font-size: .9rem; }
  .guide-gallery a {
    display: block;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: #edf2e7;
  }
  .guide-gallery img { display: block; width: 100%; height: auto; }
  .guide-end {
    padding: clamp(1rem, 4vw, 2.5rem);
    border-radius: 16px;
    background: #edf2e7;
  }
  .guide-end .button { margin-block-start: 1rem; }
  @media (max-width: 620px) {
    .guide-contents ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .35rem .8rem; }
    .guide-contents a { font-size: .92rem; line-height: 1.35; }
    .guide-gallery { grid-template-columns: 1fr; }
    .guide-gallery figure:first-child { width: min(100%, 390px); justify-self: center; }
    .guide-progression div { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .guide .button:hover { transform: none; }
  }
</style>

---
import { english as copy } from '../game-entry/locale';
---
<section class="play-shell" data-play-entry data-preview-state="first-mission-preview" lang="en" aria-labelledby="play-title">
<div class="hud-chrome" data-hud-chrome>
  <div class="hud-stats" data-hud-stats hidden aria-label="Sanctuary status" aria-live="off"><strong data-hud-coins></strong><span data-hud-welfare></span><span data-hud-guests></span><span data-hud-mission></span><span data-hud-speed aria-label="Simulation speed">1×</span></div>
<section class="save-panel" data-save-panel aria-label="Local game progress"><details class="hud-save-details" data-hud-save-details><summary><span data-save-status role="status" aria-live="off">Checking local progress...</span><span data-hud-text="saveDetails">Save details</span></summary><small data-save-detail></small></details><p data-save-error role="alert" hidden></p><button type="button" data-save-retry hidden>Retry save</button><button type="button" data-save-reload hidden>Reload saved progress</button><button type="button" data-save-recovery-review hidden>Check save recovery</button><button type="button" data-save-recovery-download hidden>Download recovery copy</button><p data-save-recovery-note role="status" hidden></p><div data-save-resume hidden><p data-save-resume-note></p><button type="button" data-save-resume-button>Resume zoo</button></div></section>
<section class="session-panel" data-session-panel hidden aria-label="Session controls"><button type="button" data-pause-toggle aria-pressed="false">Pause zoo</button><p data-pause-status role="status"></p></section><details class="hud-options" data-hud-options hidden><summary data-hud-text="options">Options</summary><div class="hud-options-body"><div class="guide-toolbar" data-guide-toolbar><span data-entry-text="guideToolbar">{copy.guideToolbar}</span><select data-guide-language data-entry-aria="language" aria-label={copy.language}><option value="en">English</option><option value="id">Bahasa Indonesia</option></select><button type="button" data-open-dialog="play-help" data-entry-text="help" disabled>{copy.help}</button><button type="button" data-open-dialog="play-settings" data-entry-text="settings" disabled>{copy.settings}</button><button type="button" data-onboarding-exit data-entry-text="guideExit">{copy.guideExit}</button><small data-entry-text="guideSession">{copy.guideSession}</small></div><div class="simulation-speed" data-speed-tools hidden><label><span data-speed-label></span> <select data-simulation-speed aria-describedby="speed-note"><option value="1">1×</option><option value="10">10×</option></select></label><span data-speed-status role="status" aria-live="polite"></span><p id="speed-note" data-speed-note></p></div><section data-hud-restart class="restart-panel" data-entry-aria="restartControls" aria-label="Restart sanctuary"><button type="button" data-reset-review hidden>Restart sanctuary</button><button type="button" data-reset-undo hidden>Restore pre-restart game</button><p data-reset-note role="status" hidden></p></section><button type="button" data-preview-close hidden>{copy.previewClose}</button><a data-hud-license class="software-notice" href="/licenses/three-MIT.txt" data-entry-text="softwareNotice">{copy.softwareNotice}</a></div></details>
</div>


  <dialog data-save-recovery-dialog aria-labelledby="save-recovery-title"><h2 id="save-recovery-title" data-save-recovery-title tabindex="-1"></h2><p data-save-recovery-explanation></p><p data-save-recovery-summary></p><p data-save-recovery-preserve></p><button type="button" data-save-recovery-confirm>Confirm</button><button type="button" data-save-recovery-cancel>Cancel</button></dialog>


  <dialog data-reset-dialog aria-labelledby="reset-title"><h2 id="reset-title" data-reset-title tabindex="-1"></h2><p data-reset-info></p><p data-reset-summary></p><p data-reset-preserve></p><button type="button" data-reset-confirm>Confirm restart</button><button type="button" data-reset-cancel>Keep current game</button></dialog>
  <div class="entry-card">
    <div class="entry-copy">
      <span class="preview-badge"><span aria-hidden="true">✦</span> <span data-entry-text="status">{copy.status}</span></span>
      <p class="sanctuary-name" data-entry-text="sanctuary">{copy.sanctuary}</p>
      <h1 id="play-title" data-entry-text="title">{copy.title}</h1>
      <p class="entry-intro" data-entry-text="intro">{copy.intro}</p>
      <p class="availability" id="play-availability" data-entry-text="availability">{copy.availability}</p>
      <div class="entry-actions">
        <button type="button" class="guide-action" disabled data-onboarding-start aria-describedby="play-availability" data-entry-text="play">{copy.play}</button>
        <button type="button" class="guide-action" disabled data-continue aria-describedby="play-availability" data-entry-text="continue">{copy.continue}</button>
        <button type="button" class="guide-action" data-open-dialog="play-help" disabled data-entry-text="help">{copy.help}</button>
        <button type="button" class="settings-action" data-open-dialog="play-settings" disabled data-entry-text="settings">{copy.settings}</button>
      </div>
      <a class="journal-return" href="/animals/"><span data-entry-text="journal">{copy.journal}</span><span aria-hidden="true">↗</span></a>
      <noscript><p class="no-script">{copy.noScript}</p></noscript>
    </div>
    <figure class="sanctuary-art" data-renderer-panel data-renderer-state="closed">
<div class="hud-body" data-guide-layout><div class="hud-world" data-hud-world><div class="preview-frame" data-hud-frame>
      <div data-preview-illustration>
      <svg viewBox="0 0 520 500" role="img" aria-labelledby="sanctuary-art-title">
        <title id="sanctuary-art-title" data-entry-text="artTitle">{copy.artTitle}</title>
        <defs><linearGradient id="creek-water" x1="0" x2="1" y1="0" y2="1"><stop stop-color="#8ac9ce"/><stop offset="1" stop-color="#4a9fba"/></linearGradient></defs>
        <circle cx="380" cy="104" r="54" fill="#f2d28a"/>
        <path d="M40 281 254 158 479 285 263 416Z" fill="#bad39b"/>
        <path d="M40 281 263 410 263 434 40 304Z" fill="#91ae74"/>
        <path d="M263 410 479 285 479 309 263 434Z" fill="#789969"/>
        <path d="M79 266C155 285 143 221 227 250S302 345 378 318L442 306 413 341C345 380 283 346 254 313S205 275 177 284 115 305 79 282Z" fill="url(#creek-water)"/>
        <path d="M100 322 167 285 198 302 132 340Z" fill="#dbc397"/>
        <path d="M157 288 222 252 245 265 180 302Z" fill="#e6d3aa"/>
        <path d="M226 252 282 220 347 257 292 290Z" fill="#d0b781"/>
        <path d="M238 245 282 220 333 250 289 275Z" fill="#c0d39b" stroke="#997448" stroke-width="3" stroke-dasharray="5 5"/>
        <path d="M264 307 303 286 337 305 299 328Z" fill="#e8d3a9"/>
        <path d="M118 197 118 269M383 196 383 273M330 145 330 215M188 151 188 212" stroke="#8c6b45" stroke-width="10" stroke-linecap="round"/>
        <path d="M118 137 89 148 76 175 85 197 112 211 141 200 156 177 148 154Z" fill="#477b60"/>
        <path d="M118 137 112 211 141 200 156 177 148 154Z" fill="#619771"/>
        <path d="M383 159 348 145 334 160 365 174 345 190 356 204 382 180 407 204 422 190 402 174 434 160 420 145 391 158 393 126 378 126Z" fill="#477b60"/>
        <path d="M383 159 382 180 407 204 422 190 402 174 434 160 420 145 391 158 393 126 383 126Z" fill="#73a37c"/>
        <path d="M330 104 307 113 296 137 306 161 333 172 356 158 365 135 352 112Z" fill="#537f5d"/>
        <path d="M188 104 166 113 156 137 166 158 191 171 214 156 223 134 211 112Z" fill="#6c9b6e"/>
        <ellipse cx="215" cy="342" rx="15" ry="9" fill="#a5b091"/>
        <ellipse cx="351" cy="357" rx="20" ry="11" fill="#9eab8b"/>
        <path d="M78 242 85 226 91 244M446 265 453 248 458 267M367 291 372 276 379 291" fill="none" stroke="#548b64" stroke-width="5" stroke-linecap="round"/>
        <path d="m270 113 8 8 9-8M294 99l7 6 7-6" fill="none" stroke="#6e8b75" stroke-width="3" stroke-linecap="round"/>
      </svg>
      </div>
      <div class="preview-stage" data-preview-stage role="group" tabindex="0" data-entry-aria="previewCanvas" aria-label={copy.previewCanvas} aria-describedby="camera-help" aria-keyshortcuts="ArrowUp ArrowDown ArrowLeft ArrowRight Home Escape Enter" hidden><span class="selection-crosshair" aria-hidden="true">+</span></div>
      <div class="preview-feedback" data-preview-feedback role="status" aria-live="polite" hidden>
        <strong data-preview-title>{copy.previewLoading}</strong>
        <p data-preview-detail>{copy.previewLoadingDetail}</p>
      </div>
      </div><fieldset class="hud-control-gate" data-hud-controls><legend class="selection-announcement" data-hud-text="actions">Game actions</legend><div class="camera-controls" data-camera-controls role="group" data-entry-aria="cameraControls" aria-label={copy.cameraControls} hidden>
        <button type="button" data-camera-command="zoom-out" data-entry-aria="cameraZoomOut" aria-label={copy.cameraZoomOut}>−</button>
        <output data-camera-zoom aria-live="off">100%</output>
        <button type="button" data-camera-command="zoom-in" data-entry-aria="cameraZoomIn" aria-label={copy.cameraZoomIn}>+</button>
        <button type="button" data-camera-command="reset">{copy.cameraReset}</button>
        <p id="camera-help" data-camera-help>{copy.cameraHelp}</p>
      </div></fieldset></div><div class="hud-rail"><div class="hud-tabs" data-hud-tabs role="tablist" aria-label="Zoo tools" hidden><button type="button" role="tab" id="hud-tab-missions" data-hud-tab="missions" aria-controls="hud-pane-missions" aria-selected="true" tabindex="0" data-hud-text="missions">Missions</button><button type="button" role="tab" id="hud-tab-care" data-hud-tab="care" aria-controls="hud-pane-care" aria-selected="false" tabindex="-1" data-hud-text="care">Care</button><button type="button" role="tab" id="hud-tab-visitors" data-hud-tab="visitors" aria-controls="hud-pane-visitors" aria-selected="false" tabindex="-1" data-hud-text="visitors">Guests</button><button type="button" role="tab" id="hud-tab-build" data-hud-tab="build" aria-controls="hud-pane-build" aria-selected="false" tabindex="-1" data-hud-text="build">Build</button></div><div class="hud-panels" data-hud-panels><div class="hud-pane" id="hud-pane-missions" data-hud-pane="missions" role="tabpanel" aria-labelledby="hud-tab-missions" tabindex="-1"><fieldset class="hud-control-gate" data-hud-controls><legend class="selection-announcement" data-hud-text="actions">Game actions</legend><section class="macaw-tools" data-mission-tools hidden aria-labelledby="missions-title"><h3 id="missions-title" data-missions-title></h3><p data-missions-hint></p><section data-onboarding-tools hidden aria-labelledby="onboarding-title"><h4 id="onboarding-title" data-onboarding-title></h4><ol data-onboarding-steps></ol><p data-onboarding-hint></p><p data-onboarding-price></p><p data-onboarding-reason role="status" aria-live="polite"></p><div class="macaw-actions"><button type="button" data-onboarding-action></button><button type="button" data-onboarding-confirm hidden></button><button type="button" data-onboarding-cancel hidden></button></div></section><section data-care-mission hidden aria-labelledby="care-mission-title"><h4 id="care-mission-title" data-care-mission-title></h4><p data-care-mission-hint></p><ul data-care-mission-birds aria-live="off"></ul><p data-care-mission-timer aria-live="off"></p><p data-care-mission-status></p><p data-care-mission-reward></p><button type="button" data-care-mission-action></button></section><section data-visitor-mission hidden aria-labelledby="visitor-mission-title"><h4 id="visitor-mission-title" data-visitor-mission-title></h4><p data-visitor-mission-hint></p><p data-visitor-mission-admissions></p><p data-visitor-mission-viewings></p><p data-visitor-mission-status></p><p data-visitor-mission-reward></p><p data-visitor-mission-badge hidden role="status"></p><button type="button" data-visitor-mission-action></button></section><section data-thriving-mission hidden aria-labelledby="thriving-title"><h4 id="thriving-title" data-thriving-title></h4><p data-thriving-hint></p><p data-thriving-timer aria-live="off"></p><p data-thriving-income aria-live="off"></p><p data-thriving-status></p><p data-thriving-reward></p><p data-thriving-badge role="status" hidden></p><button type="button" data-thriving-action></button><details data-thriving-expansion hidden><summary data-thriving-expansion-title></summary><p data-thriving-expansion-text></p></details></section><div data-missions-objective hidden></div><p data-missions-status tabindex="-1" role="status" aria-live="polite"></p><button type="button" data-mission-claim disabled></button><p data-missions-total></p><details data-missions-roadmap><summary data-missions-summary></summary><ol data-missions-list></ol></details><p data-missions-note hidden></p></section></fieldset></div><div class="hud-pane" id="hud-pane-care" data-hud-pane="care" role="tabpanel" aria-labelledby="hud-tab-care" tabindex="-1"><div class="hud-control-gate"><section class="bird-tools macaw-tools" data-recovery-tools hidden aria-labelledby="recovery-title"><h3 id="recovery-title" data-recovery-title role="status"></h3><fieldset class="hud-control-gate" data-hud-controls aria-labelledby="recovery-title"><p data-recovery-intro></p><p data-recovery-next></p><p data-recovery-cost></p><p data-recovery-wait></p><button type="button" data-recovery-review></button></fieldset></section><section class="bird-tools macaw-tools" data-bird-tools hidden aria-labelledby="birds-title">
        <h3 id="birds-title" data-entry-text="birdsTitle">{copy.birdsTitle}</h3>
        <p data-entry-text="birdsHint">{copy.birdsHint}</p>
        <fieldset class="hud-control-gate" data-hud-controls aria-labelledby="birds-title"><button type="button" data-birds-command="welcome" disabled>{copy.birdsWelcome}</button>
        <button type="button" data-birds-command="reserve" hidden>{copy.birdsReserve}</button></fieldset>
        <p data-birds-status role="status" aria-live="polite"></p>
        <p data-entry-text="careHint">{copy.careHint}</p>
        <ul data-birds-list aria-live="off"></ul>
        <section id="animal-details" class="animal-details" data-animal-detail hidden aria-labelledby="animal-info-title">
          <h4 id="animal-info-title" data-care-name tabindex="-1"></h4>
          <button type="button" data-care-dismiss data-entry-text="careDismiss">{copy.careDismiss}</button>
          <p data-care-welfare aria-live="off"></p>
          <ul class="care-parts" aria-live="off">{['food','water','habitat','enrichment'].map(part=><li data-care-part={part}></li>)}</ul>
          <p data-entry-text="careFormula">{copy.careFormula}</p>
          <p data-entry-text="careAccess">{copy.careAccess}</p>
          <ul data-care-alerts aria-live="off"></ul>
        </section>
        <output class="selection-announcement" data-care-announcement aria-live="polite" aria-atomic="true"></output>
      </section><section class="macaw-tools" data-food-tools hidden aria-labelledby="food-title">
        <h3 id="food-title" data-entry-text="foodTitle">{copy.foodTitle}</h3><fieldset class="hud-control-gate" data-hud-controls aria-labelledby="food-title">
        <p data-entry-text="foodHint">{copy.foodHint}</p>
        <button type="button" data-food-command="preview" disabled>{copy.foodPlace}</button>
        <div data-food-preview hidden><p data-entry-text="foodPreview">{copy.foodPreview}</p><button type="button" data-food-command="confirm">{copy.foodConfirm}</button> <button type="button" data-food-command="cancel">{copy.foodCancel}</button></div>
        <div data-food-actions hidden><button type="button" data-food-command="refill">{copy.foodFill}</button> <button type="button" data-food-remove>{copy.foodRemove}</button></div>
        <p data-economy-cost="food"></p><p data-food-status role="status" aria-live="polite"></p>
      </fieldset></section><section class="macaw-tools" data-water-tools hidden aria-labelledby="water-title">
        <h3 id="water-title" data-entry-text="waterTitle">{copy.waterTitle}</h3><fieldset class="hud-control-gate" data-hud-controls aria-labelledby="water-title">
        <p data-entry-text="waterHint">{copy.waterHint}</p>
        <button type="button" data-water-command="preview" disabled>{copy.waterPlace}</button>
        <div data-water-preview hidden><p data-entry-text="waterPreview">{copy.waterPreview}</p><button type="button" data-water-command="confirm">{copy.waterConfirm}</button> <button type="button" data-water-command="cancel">{copy.waterCancel}</button></div>
        <div data-water-actions hidden><button type="button" data-water-command="refill">{copy.waterFill}</button> <button type="button" data-water-remove>{copy.waterRemove}</button></div>
        <p data-economy-cost="water"></p><p data-water-status role="status" aria-live="polite"></p>
      </fieldset></section><section class="macaw-tools" data-perch-tools hidden aria-labelledby="perch-title">
        <h3 id="perch-title" data-entry-text="perchTitle">{copy.perchTitle}</h3><fieldset class="hud-control-gate" data-hud-controls aria-labelledby="perch-title">
        <p data-entry-text="perchHint">{copy.perchHint}</p>
        <button type="button" data-perch-command="preview" disabled>{copy.perchPlace}</button>
        <div data-perch-preview hidden><p data-entry-text="perchPreview">{copy.perchPreview}</p><button type="button" data-perch-command="confirm">{copy.perchConfirm}</button> <button type="button" data-perch-command="cancel">{copy.perchCancel}</button></div>
        <div data-perch-actions hidden><button type="button" data-perch-remove>{copy.perchRemove}</button></div>
        <p data-economy-cost="perch"></p><p data-perch-status role="status" aria-live="polite"></p>
      </fieldset></section></div></div><div class="hud-pane" id="hud-pane-visitors" data-hud-pane="visitors" role="tabpanel" aria-labelledby="hud-tab-visitors" tabindex="-1"><fieldset class="hud-control-gate" data-hud-controls><legend class="selection-announcement" data-hud-text="actions">Game actions</legend><section class="macaw-tools" data-visitor-tools hidden aria-labelledby="visitors-title">
        <h3 id="visitors-title" data-entry-text="visitorsTitle">{copy.visitorsTitle}</h3>
        <p data-entry-text="visitorsHint">{copy.visitorsHint}</p>
        <div class="macaw-actions"><button type="button" data-visitors-command="open">{copy.visitorsOpen}</button><button type="button" data-visitors-command="close" hidden>{copy.visitorsClose}</button><button type="button" data-visitors-command="focus">{copy.visitorsFocus}</button><button type="button" data-visitors-command="follow">{copy.visitorsFollow}</button></div>
        <p data-economy-status role="status" aria-live="polite"></p><div data-cashflow style="border-inline-start:3px solid currentColor;padding-inline-start:.8rem;margin-block:1rem"></div><p data-attraction></p><p data-ticket-balance style="font-weight:700"></p><p data-ticket-status></p><p data-ticket-last role="status" aria-live="polite"></p><p data-ticket-note style="font-size:.9em"></p><p data-visitors-status role="status" aria-live="polite"></p><ul data-visitor-list aria-live="off"></ul><p data-visitor-satisfaction role="status" aria-live="polite"></p><ul data-visitor-recent data-entry-aria="visitorRecentLabel" aria-label={copy.visitorRecentLabel}></ul>
      </section></fieldset></div><div class="hud-pane" id="hud-pane-build" data-hud-pane="build" role="tabpanel" aria-labelledby="hud-tab-build" tabindex="-1"><fieldset class="hud-control-gate" data-hud-controls><legend class="selection-announcement" data-hud-text="actions">Game actions</legend><section class="placement-tools" data-placement-tools hidden aria-labelledby="placement-title">
        <button type="button" data-placement-command="begin">{copy.placementStart}</button>
        <button type="button" data-placement-command="begin-path">{copy.pathStart}</button>
        <p data-economy-cost="placement"></p><p data-access-status role="status" aria-live="polite"></p>
        <button type="button" data-edit-undo hidden>{copy.editUndo}</button>
        <p data-entry-text="editHint">{copy.editHint}</p>
        <p data-edit-status role="status" aria-live="polite"></p>
        <div data-placement-edit hidden>
          <h3 id="placement-title" data-placement-text="placementTitle">{copy.placementTitle}</h3>
          <p data-placement-text="placementHint">{copy.placementHint}</p>
          <p data-placement-location></p><p data-placement-reason role="status" aria-live="polite"></p>
          <div class="placement-arrows" role="group" data-entry-aria="placementTitle" aria-label={copy.placementTitle}>
            <button type="button" data-placement-command="left" data-entry-aria="placementLeft" aria-label={copy.placementLeft}>←</button>
            <button type="button" data-placement-command="up" data-entry-aria="placementUp" aria-label={copy.placementUp}>↑</button>
            <button type="button" data-placement-command="down" data-entry-aria="placementDown" aria-label={copy.placementDown}>↓</button>
            <button type="button" data-placement-command="right" data-entry-aria="placementRight" aria-label={copy.placementRight}>→</button>
          </div>
          <div class="placement-actions"><button type="button" data-placement-command="confirm" disabled>{copy.placementConfirm}</button><button type="button" data-placement-command="cancel">{copy.placementCancel}</button></div>
        </div>
        <p data-placement-confirmed role="status" hidden>{copy.placementConfirmed}</p>
      </section><section class="scene-selection" data-scene-selection aria-labelledby="scene-selection-title" hidden>
        <div><h3 id="scene-selection-title" data-selection-title></h3><button type="button" data-clear-selection>{copy.selectionDismiss}</button></div>
        <p data-selection-location></p><p data-selection-detail></p>
        <button type="button" data-edit-remove hidden>{copy.editRemove}</button>
      </section><section class="macaw-tools" data-macaw-tools hidden aria-labelledby="macaw-title">
        <button type="button" data-studio-command="open">{copy.macawOpen}</button>
        <div data-macaw-controls hidden>
          <h3 id="macaw-title" data-entry-text="macawTitle">{copy.macawTitle}</h3>
          <p data-entry-text="macawSubtitle">{copy.macawSubtitle}</p>
          <p data-entry-text="macawNotice">{copy.macawNotice}</p>
          <label for="macaw-animation" data-entry-text="macawAnimation">{copy.macawAnimation}</label>
          <select id="macaw-animation" data-macaw-clip>{['perch','walk','hop','fly','eat','drink','rest'].map(clip=><option value={clip}>{copy[`macaw${clip[0].toUpperCase()}${clip.slice(1)}` as keyof typeof copy]}</option>)}</select>
          <label for="macaw-angle" data-entry-text="macawView">{copy.macawView}</label>
          <select id="macaw-angle" data-macaw-angle>{['quarter','front','side','back'].map(angle=><option value={angle}>{copy[`macaw${angle[0].toUpperCase()}${angle.slice(1)}` as keyof typeof copy]}</option>)}</select>
          <div class="macaw-actions"><button type="button" data-studio-command="pause">{copy.macawPause}</button><button type="button" data-studio-command="habitat">{copy.macawHabitat}</button><button type="button" data-studio-command="detail" hidden>{copy.macawDetail}</button><button type="button" data-studio-command="close">{copy.macawClose}</button></div>
          <p data-macaw-status role="status" aria-live="polite"></p><p data-macaw-scale></p>
        </div>
      </section></fieldset></div></div></div></div><div class="preview-controls" data-hud-preview-controls>
        <button type="button" data-preview-open disabled>{copy.previewOpen}</button>
        <button type="button" data-preview-retry hidden>{copy.previewRetry}</button>
        <button type="button" data-preview-reload hidden>{copy.previewReload}</button>

      </div><figcaption data-preview-caption>{copy.artCaption}</figcaption><output class="selection-announcement" data-selection-announcement aria-live="polite" aria-atomic="true"></output>
</figure>
  </div>

<dialog data-recovery-dialog aria-labelledby="recovery-dialog-title"><h2 id="recovery-dialog-title" tabindex="-1"></h2><p data-recovery-confirm-step></p><p data-recovery-confirm-cost></p><div class="macaw-actions"><button type="button" class="dialog-close" data-recovery-cancel></button><button type="button" class="dialog-close" data-recovery-confirm></button></div></dialog>
  <dialog data-food-dialog aria-labelledby="food-dialog-title">
    <h2 id="food-dialog-title" tabindex="-1" data-entry-text="foodRemoveTitle">{copy.foodRemoveTitle}</h2><p data-entry-text="foodRemoveHint">{copy.foodRemoveHint}</p>
    <button type="button" class="dialog-close" data-food-keep>{copy.foodKeep}</button><button type="button" class="dialog-close" data-food-remove-confirm>{copy.foodRemoveConfirm}</button>
  </dialog>
  <dialog data-water-dialog aria-labelledby="water-dialog-title">
    <h2 id="water-dialog-title" tabindex="-1" data-entry-text="waterRemoveTitle">{copy.waterRemoveTitle}</h2><p data-entry-text="waterRemoveHint">{copy.waterRemoveHint}</p>
    <button type="button" class="dialog-close" data-water-keep>{copy.waterKeep}</button><button type="button" class="dialog-close" data-water-remove-confirm>{copy.waterRemoveConfirm}</button>
  </dialog>
  <dialog data-perch-dialog aria-labelledby="perch-dialog-title">

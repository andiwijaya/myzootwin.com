---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { animalStories, type AnimalStory } from '../../articles/stories';
import { siteUrl } from '../../seo.mjs';
import '../../articles/articles.css';

export function getStaticPaths() {
  return animalStories.map(story => ({ params: { slug: story.slug }, props: { story } }));
}

interface Props {
  story: AnimalStory;
}

const { story } = Astro.props;
const socialImage = { src: story.image.src, width: story.image.width, height: story.image.height, alt: story.alt };
const href = `/artikel/${story.slug}/`;
const author = { '@type': 'Organization', name: 'MyZooTwin', url: siteUrl('/about/') };
const breadcrumbs = [{ href: '/', name: 'Beranda' }, { href: '/artikel/', name: 'Artikel Satwa' }, { href, name: story.species }];
const structuredData = [{
  '@type': 'Article',
  mainEntityOfPage: siteUrl(href), url: siteUrl(href), headline: story.title,
  description: story.description, image: [siteUrl(story.image.src)], inLanguage: 'id',
  author, publisher: author, citation: story.source.href,
  about: { '@type': 'Thing', name: story.species, alternateName: story.scientificName },
}];
const title = story.slug === 'gajah' ? `${story.title} | Gajah Asia — MyZooTwin` : `${story.title} — MyZooTwin`;
---
<BaseLayout gameStories article locale="id" title={title} description={story.description} socialImage={socialImage} {breadcrumbs} {structuredData}>
  <article class="animal-story" data-animal-story={story.slug}>
    <header class="animal-story-intro">
      <p class="article-species">{story.species} <i>{story.scientificName}</i></p>
      <h1>{story.title}</h1>
      <p class="animal-story-lead">{story.description}</p>
      <p class="story-byline">Oleh <a href="/about/" hreflang="en">MyZooTwin</a></p>
    </header>
    <figure class="animal-story-picture">
      <img src={story.image.src} width={story.image.width} height={story.image.height}
        alt={story.alt} fetchpriority="high" decoding="async" data-article-photo />
      <figcaption>Ilustrasi fotorealistis dibuat dengan ImageGen</figcaption>
    </figure>
    <div class="animal-story-body">
      <section aria-labelledby="story-scene-title">
        <p class="story-setting">Kisah di {story.habitat}</p>
        <h2 id="story-scene-title">{story.scene}</h2>
        {story.story.map(paragraph => <p>{paragraph}</p>)}
      </section>
      <section aria-labelledby="story-wild-title">
        <h2 id="story-wild-title">Di alam</h2>
        {story.wild.map((paragraph, index) => (
          <p>{paragraph}{index === story.wild.length - 1 && <> <a href={story.source.href}>{story.source.label}</a></>}</p>
        ))}
      </section>
      <section class="story-try" aria-labelledby="story-try-title">
        <h2 id="story-try-title">Coba amati di game</h2>
        <p>{story.tryInGame}</p>
        <div>
          <a class="button" href="/play/">Main Sekarang</a>
          <a class="article-back" href={story.slug === 'makaw' ? '/tutorial/#rawat' : '/tutorial/#habitat'}>Lihat tutorial</a>
        </div>
      </section>
      <section class="story-related" aria-labelledby="story-related-title">
        <h2 id="story-related-title">Baca juga</h2>
        <ul>{animalStories.filter(other => other.slug !== story.slug).map(other => (
          <li><a href={`/artikel/${other.slug}/`}>{other.title}</a></li>
        ))}</ul>
      </section>
    </div>
  </article>
</BaseLayout>
<style>
  .story-byline{font-size:.9rem;color:var(--muted)}.story-byline a,.story-related a{color:var(--forest);text-decoration:underline;text-underline-offset:.2em}.story-related{border-top:1px solid var(--line);padding-top:1.5rem}.story-related ul{padding-inline-start:1.25rem}
</style>

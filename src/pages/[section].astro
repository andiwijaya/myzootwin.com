---
import BaseLayout from '../layouts/BaseLayout.astro';
import { unpublishedSections } from '../seo.mjs';

export function getStaticPaths() {
  return unpublishedSections.map(section => ({ params: { section } }));
}

const section = Astro.params.section;
const copy: Record<string, [string, string]> = {
  wildlife: ['Wildlife', 'Our wildlife section is not open yet. In the meantime, explore five species in the MyZooTwin animal library.'],
  pets: ['Pets', 'Our companion animal guides are not published yet. The current MyZooTwin library focuses on the animals featured in the zoo game.'],
  adventures: ['Field Notes & Adventures', 'We have not published our field notes here yet. Start with the animal stories set in the five MyZooTwin habitats.'],
  gear: ['Gear & Equipment', 'MyZooTwin has not published any equipment guides or reviews yet. Browse the animal library or learn how the zoo simulation works.'],
};
const [title, description] = copy[section];
---
<BaseLayout title={title + ' — MyZooTwin'} {description}>
  <section class="section-page">
    <p class="eyebrow">MyZooTwin · Coming soon</p>
    <h1>{title}</h1>
    <p>{description}</p>
    <a class="button" href="/animals/">Explore the animal library</a>
  </section>
</BaseLayout>
<style>
  .section-page{padding:clamp(4rem,10vw,8rem) clamp(1.2rem,10vw,10rem);min-height:62vh;background:var(--cream)}.section-page h1{font-size:clamp(2.6rem,8vw,6rem);margin:1rem 0}.section-page>p:not(.eyebrow){font-size:1.15rem;color:var(--muted);max-width:56ch}
</style>
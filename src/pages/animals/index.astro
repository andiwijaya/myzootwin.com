---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Animals — MyZooTwin"><section class="listing"><p class="eyebrow">The animal library</p><h1>Meet the<br /><em>neighborhood.</em></h1><p class="lead">A growing home for species profiles and practical introductions. We are preparing the first field notes now.</p><div class="empty-card"><span class="pillar-icon">✦</span><h2>First profiles are on the way</h2><p>When the library opens, each profile will bring together accessible context, trustworthy sources, and plenty of room for wonder.</p><a class="button" href="/about/">Learn about MyZooTwin →</a></div></section></BaseLayout>
<style>.listing{padding:clamp(5rem,11vw,10rem) clamp(1.2rem,10vw,10rem);background:var(--cream);min-height:70vh}.listing h1{font-size:clamp(3.5rem,8vw,7rem);margin:1rem 0}.listing h1 em{font-style:normal;color:var(--gold)}.lead{font-size:1.15rem;color:var(--muted);max-width:34rem}.empty-card{margin-top:5rem;max-width:620px;padding:2.5rem;background:var(--paper);border:1px solid var(--line)}.empty-card h2{font-size:2rem;margin:1.4rem 0 .5rem}.empty-card p{color:var(--muted);margin-bottom:1.7rem}.pillar-icon{display:grid;place-items:center;width:3.1rem;height:3.1rem;border:1px solid var(--gold);border-radius:50%;color:var(--gold)}
</style>

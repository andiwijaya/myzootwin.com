---
import BaseLayout from '../layouts/BaseLayout.astro';
import {sanctuaryImage} from '../site-content';
---
<BaseLayout gameHome title="MyZooTwin — Build a Living Zoo" description="Play Tropical Creek Sanctuary: build an aviary, care for two macaws, welcome visitors and complete four missions. Free browser play with local progress, in Indonesian or English." socialImage={sanctuaryImage}>
  <section class="game-hero" aria-labelledby="game-title">
    <div class="game-copy">
      <p class="eyebrow">Tropical Creek Sanctuary</p>
      <h1 id="game-title">Your little zoo.<br /><em>A world alive.</em></h1>
      <p class="game-intro">Build an aviary, care for two curious macaws and welcome your first visitors in a cozy 3D zoo.</p>
      <a class="button" href="/play/" data-site-source="home">Play Zoo <span aria-hidden="true">→</span></a>
      <p class="game-details">Play in your browser · No account needed<br />Bahasa Indonesia / English · Progress saved on this device</p>
    </div>
    <figure class="game-image">
      <img src={sanctuaryImage.src} width="1366" height="768" alt={sanctuaryImage.alt} fetchpriority="high" />
      <figcaption>Actual gameplay · Indonesian and English interfaces available</figcaption>
    </figure>
    <ul class="game-highlights" aria-label="What you can play">
      <li><strong>Build your sanctuary</strong><span>Place an aviary and connect paths for visitors.</span></li>
      <li><strong>Care for two macaws</strong><span>Provide food, water and perches. Watch your birds respond.</span></li>
      <li><strong>Keep it thriving</strong><span>Earn visitor tickets, complete four missions and continue your saved zoo.</span></li>
    </ul>
  </section>
</BaseLayout>
<style>
.game-hero{padding:clamp(2rem,5vw,4.5rem) clamp(1.2rem,5vw,5rem);display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(1.5rem,4vw,3.5rem);align-items:center;background:#edf2e7}
.game-copy{max-width:34rem;min-width:0}.game-copy h1{font-size:clamp(2.8rem,4.8vw,4.9rem);line-height:1.08;margin:1rem 0 1.3rem}.game-copy h1 em{font-style:normal;color:var(--forest)}.game-intro{font-size:1.06rem;color:#435d4f;max-width:30rem;margin:0 0 1.5rem}.game-copy .button{min-height:48px}.game-details{font-size:.84rem;color:#435d4f;line-height:1.8;margin:1.2rem 0 0}.game-image{margin:0;min-width:0}.game-image img{display:block;width:100%;height:auto;border:1px solid #b4c3a6;border-radius:18px;box-shadow:0 12px 32px #183b3214}.game-image figcaption{font-size:.75rem;color:#4f6556;line-height:1.5;margin:.75rem .35rem 0}.game-highlights{grid-column:1/-1;list-style:none;padding:1.5rem 0 0;margin:0;border-top:1px solid #c9d5bf;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem}.game-highlights li{display:grid;gap:.35rem;align-content:start}.game-highlights strong{font-size:1rem}.game-highlights span{font-size:.9rem;color:#435d4f;max-width:25rem}
:global(body.game-home .site-header){height:auto;min-height:76px;flex-wrap:nowrap;gap:1rem;padding-block:.75rem}:global(body.game-home .site-header nav){width:auto;order:initial;overflow:visible;padding:0;gap:clamp(.75rem,2vw,1.5rem)}:global(body.game-home .site-header nav a){display:inline-flex;align-items:center;min-height:44px}:global(body.game-home .site-header nav [aria-current="page"]){text-decoration:underline;text-underline-offset:.35rem}:global(body.game-home .site-footer){padding-top:2.5rem;gap:2rem}:global(body.game-home .footer-links a){display:inline-flex;align-items:center;min-height:44px}
@media(max-width:900px){.game-hero{grid-template-columns:1fr;gap:2rem}.game-copy{max-width:42rem}.game-copy h1{font-size:clamp(2.8rem,7vw,4.2rem)}.game-image{max-width:60rem}.game-highlights{gap:1.5rem}}
@media(max-width:560px){.game-highlights{grid-template-columns:1fr;gap:1.25rem}.game-copy h1{font-size:clamp(2.6rem,12vw,3.6rem)}:global(body.game-home .brand){font-size:1.05rem;gap:.4rem}:global(body.game-home .site-header){padding-inline:1.2rem}:global(body.game-home .site-header nav){font-size:.85rem}:global(body.game-home .site-footer){gap:1.2rem}:global(body.game-home .site-footer p){margin-bottom:0}}
@media(prefers-reduced-motion:reduce){.button:hover{transform:none}}
</style>

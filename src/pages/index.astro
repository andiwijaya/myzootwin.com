---
import BaseLayout from '../layouts/BaseLayout.astro';
const pillars = [
  { icon: '◌', title: 'Discover animals', text: 'Build a better mental map of the animal kingdom, one species at a time.', href: '/animals/' },
  { icon: '⌁', title: 'Into the wild', text: 'Follow habitats, behavior, and the stories unfolding beyond the familiar.', href: '/wildlife/' },
  { icon: '♡', title: 'Life with pets', text: 'Thoughtful guides for sharing a healthier, more enriching life with companion animals.', href: '/pets/' },
  { icon: '✧', title: 'Learn something wild', text: 'Clear explainers that make animal science feel useful, memorable, and close to home.', href: '/learn/' }
];
---
<BaseLayout>
  <section class="hero"><div class="hero-copy"><p class="eyebrow">A field guide for the curious</p><h1>Explore.<br /><em>Understand.</em><br />Care more.</h1><p class="hero-text">MyZooTwin is an animal learning journal for people who want to look a little closer — at wildlife, pets, and the living world around us.</p><a class="button" href="/animals/">Start exploring <span aria-hidden="true">→</span></a></div><div class="hero-art"><img src="/images/myzootwin-beranda.png" width="1024" height="1536" alt="MyZooTwin explorer surrounded by a parrot, elephant, giraffe, dogs, cat, rabbit, lion, and tortoise" fetchpriority="high" /></div><div class="hero-note">Same planet.<br /><strong>More friends.</strong></div></section>
  <section class="intro"><div><p class="eyebrow">Find your next wonder</p><h2>There is always<br /><em>more to notice.</em></h2></div><p>From a familiar pet’s hidden signals to the quiet logic of a wild habitat, every animal has a story worth meeting with curiosity.</p></section>
  <section class="pillars">{pillars.map((pillar) => <a class="pillar" href={pillar.href}><span class="pillar-icon" aria-hidden="true">{pillar.icon}</span><h3>{pillar.title}</h3><p>{pillar.text}</p><span class="arrow" aria-hidden="true">↗</span></a>)}</section>
  <section class="journal"><div><p class="eyebrow">The MyZooTwin journal</p><h2>Useful knowledge.<br /><em>Wonder intact.</em></h2><p>We are building a dependable home for animal profiles, field notes, practical pet care, and stories from the wild. The first entries are coming soon.</p><a class="button secondary" href="/about/">Meet the project <span aria-hidden="true">→</span></a></div><div class="journal-card"><div class="card-top"><span>FIELD NOTE 001</span><span>MYZOOTWIN</span></div><div class="card-symbol">✦</div><p>“The best way to learn about animals is to stay curious long enough for the ordinary to become extraordinary.”</p><span class="card-line"></span></div></section>
</BaseLayout>
<style>
.hero{min-height:calc(100vh - 80px);display:grid;grid-template-columns:minmax(280px,.8fr) minmax(420px,1.2fr);position:relative;overflow:hidden;background:var(--cream)}.hero-copy{padding:clamp(4rem,9vw,8rem) clamp(1.2rem,4vw,5rem);align-self:center;position:relative;z-index:2}.hero-copy h1{color:var(--ink)}.hero-copy h1 em,.intro h2 em,.journal h2 em{font-style:normal;color:var(--gold)}.hero-text{max-width:31rem;color:#53645b;font-size:1.06rem;margin:1.6rem 0 2rem}.hero-art{min-height:680px;position:relative;overflow:hidden;background:#b5d6df}.hero-art:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,var(--cream) 0%,transparent 16%);pointer-events:none}.hero-art img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block}.hero-note{position:absolute;right:5%;bottom:2.5rem;color:var(--ink);font-family:'Playfair Display',serif;font-size:1.35rem;line-height:1.1;transform:rotate(-5deg);z-index:2}.hero-note strong{color:var(--gold)}.intro{max-width:1200px;margin:auto;padding:clamp(5rem,10vw,9rem) clamp(1.2rem,4vw,4rem);display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:end}.intro>p{font-size:1.2rem;color:var(--muted);max-width:31rem;margin:0}.pillars{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);max-width:1400px;margin:0 auto;padding:0 clamp(1.2rem,4vw,4rem)}.pillar{padding:2.7rem 1.3rem 3rem;border-right:1px solid var(--line);position:relative;transition:background .2s,transform .2s}.pillar:first-child{border-left:1px solid var(--line)}.pillar:hover{background:#fbf5e8;transform:translateY(-4px)}.pillar-icon{display:grid;place-items:center;width:3.1rem;height:3.1rem;border:1px solid var(--gold);border-radius:50%;font-size:1.4rem;color:var(--gold)}.pillar h3{font-size:1.55rem;margin:1.4rem 0 .6rem}.pillar p{color:var(--muted);font-size:.92rem;max-width:15rem}.arrow{position:absolute;right:1.3rem;bottom:1.4rem;color:var(--gold);font-size:1.2rem}.journal{max-width:1200px;margin:auto;padding:clamp(5rem,10vw,9rem) clamp(1.2rem,4vw,4rem);display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}.journal p:not(.eyebrow){color:var(--muted);max-width:30rem;margin:1.5rem 0 2rem}.journal-card{background:var(--forest);color:#fff;min-height:360px;padding:2rem;display:flex;flex-direction:column;justify-content:space-between;box-shadow:16px 16px 0 var(--gold)}.card-top{display:flex;justify-content:space-between;font-size:.68rem;letter-spacing:.16em;color:#c9d9ce}.card-symbol{font-size:4rem;color:var(--gold);line-height:1}.journal-card p{font-family:'Playfair Display',serif;font-size:1.7rem;line-height:1.2;margin:0;max-width:23rem}.card-line{width:3rem;height:2px;background:var(--gold)}
@media (max-width:900px){.hero{grid-template-columns:1fr;min-height:0}.hero-copy{padding-top:5rem;padding-bottom:3rem}.hero-art{min-height:540px;max-height:70vh}.hero-art:after{background:linear-gradient(180deg,var(--cream) 0%,transparent 18%)}.hero-note{bottom:1rem}.pillars{grid-template-columns:1fr 1fr}.pillar:nth-child(2){border-right:0}.pillar:nth-child(3){border-left:1px solid var(--line);border-top:1px solid var(--line)}.pillar:nth-child(4){border-top:1px solid var(--line)}}
@media (max-width:560px){.hero-copy{padding-top:3.5rem}.hero-copy h1{font-size:3.5rem}.hero-art{min-height:500px}.hero-art img{object-position:55% top}.hero-note{font-size:1.1rem;right:1.2rem}.intro,.journal{grid-template-columns:1fr;gap:2rem}.intro>p{font-size:1rem}.pillars{grid-template-columns:1fr;padding:0 1.2rem}.pillar,.pillar:first-child,.pillar:nth-child(2),.pillar:nth-child(3){border-left:0;border-right:0;border-top:0;border-bottom:1px solid var(--line);padding:2rem .4rem}.pillar:last-child{border-bottom:0}.journal-card{min-height:300px;box-shadow:10px 10px 0 var(--gold)}}
</style>

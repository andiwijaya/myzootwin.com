---
import {pagePrivacy} from '../site-policy';
import SitePrivacy from '../components/SitePrivacy.astro';
import { canonicalPath, isIndexablePath, siteUrl } from '../seo.mjs';

interface Props {
  title: string;
  description: string;
  locale?: 'id' | 'en';
  gameHome?: boolean;
  gameGuide?: boolean;
  gameStories?: boolean;
  notFound?: boolean;
  socialImage?: { src: string; alt: string; width?: number; height?: number };
  article?: boolean;
  breadcrumbs?: readonly { href: string; name: string }[];
  structuredData?: readonly Record<string, unknown>[];
}

const { title, description, notFound, breadcrumbs = [], structuredData = [], article } = Astro.props;
const currentPath = canonicalPath(Astro.url.pathname);
const canonical = siteUrl(currentPath);
const indexable = !notFound && isIndexablePath(currentPath);
const gameHome = Astro.props.gameHome === true;
const gameGuide = Astro.props.gameGuide === true;
const gameStories = Astro.props.gameStories === true;
const gamePage = gameHome || gameGuide || gameStories;
const locale = Astro.props.locale === 'id' ? 'id' : 'en';
const homePath = locale === 'id' ? '/' : '/en/';
const tutorialPath = locale === 'id' ? '/tutorial/' : '/en/tutorial/';
const localizedPaths = gameGuide ? {id:'/tutorial/',en:'/en/tutorial/'} : {id:'/',en:'/en/'};
const alternateLocale = locale === 'id' ? 'en' : 'id';
const hasAlternates = gameHome || gameGuide;
const socialImage = Astro.props.socialImage ?? (indexable ? {
  src: '/images/home/v5-zoo-social.jpg', width: 1200, height: 630,
  alt: locale === 'id' ? 'Lima habitat di peta zoo 3D MyZooTwin.' : 'Five habitats on the MyZooTwin 3D zoo map.',
} : undefined);
const articlesLabel = locale === 'id' ? 'Artikel' : 'Articles (ID)';
const ui = locale === 'id' ? {skip:'Langsung ke konten utama',home:'Beranda',play:'Main Sekarang',nav:'Navigasi utama',brand:'Beranda MyZooTwin',tagline:'Bangun zoo yang hidup. Rawat para penghuninya.',footer:'Dibuat untuk rasa ingin tahu.',privacy:'Pilihan privasi'} : {skip:'Skip to main content',home:'Home',play:'Play Now',nav:'Main navigation',brand:'MyZooTwin home',tagline:'Build a living zoo. Care for its animals.',footer:'Made for curious minds.',privacy:'Privacy choices'};
const gaId = import.meta.env.PUBLIC_GA4_ID;
const privacy = pagePrivacy(Astro.url.pathname, Boolean(gaId));
const graph = [...structuredData];
if (breadcrumbs.length > 1) graph.push({
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map(({ href, name }, i) => ({
    '@type': 'ListItem', position: i + 1, name, item: siteUrl(href),
  })),
});
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    {privacy.csp && <meta http-equiv="Content-Security-Policy" content={privacy.csp} />}
    {privacy.referrer && <meta name="referrer" content={privacy.referrer} />}
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'max-image-preview:large' : 'noindex, follow'} />
    {!notFound && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="MyZooTwin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={locale === 'id' ? 'id_ID' : 'en_US'} />
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta property="og:image" content={siteUrl(socialImage.src)} />}
    {socialImage && <meta property="og:image:alt" content={socialImage.alt} />}
    {socialImage && <meta name="twitter:image" content={siteUrl(socialImage.src)} />}
    {socialImage && <meta name="twitter:image:alt" content={socialImage.alt} />}
    {hasAlternates && <><link rel="alternate" hreflang="id" href={siteUrl(localizedPaths.id)} /><link rel="alternate" hreflang="en" href={siteUrl(localizedPaths.en)} /><link rel="alternate" hreflang="x-default" href={siteUrl(localizedPaths.id)} /><meta property="og:locale:alternate" content={locale === 'id' ? 'en_US' : 'id_ID'} /></>}
    {socialImage?.width && <meta property="og:image:width" content={String(socialImage.width)} />}
    {socialImage?.height && <meta property="og:image:height" content={String(socialImage.height)} />}
    <title>{title}</title>
    {indexable && graph.length > 0 && <script is:inline type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body class={gameHome ? "game-home" : gamePage ? "game-reading" : undefined}>
    <a class="skip-link" href="#main-content" lang={locale}>{ui.skip}</a>
    <header class="site-header" lang={locale}>
      <a class="brand" href={homePath} aria-label={ui.brand}><span class="brand-mark">✦</span><span>MyZoo<span class="brand-accent">Twin</span></span></a>
      <nav aria-label={ui.nav}>
        {gamePage && <a href={homePath} aria-current={gameHome ? "page" : undefined}>{ui.home}</a>}
        <a class="play-link" href="/play/" data-site-source="nav" aria-current={currentPath === '/play/' ? 'page' : undefined}>{ui.play}</a>
        <a href={tutorialPath} aria-current={currentPath === tutorialPath ? "page" : undefined}>Tutorial</a>
        <a href="/artikel/" hreflang="id" aria-current={currentPath === '/artikel/' ? "page" : undefined} data-site-articles>{articlesLabel}</a>
        {hasAlternates && <a class="language-link" href={localizedPaths[alternateLocale]} lang={alternateLocale} hreflang={alternateLocale}>{locale === "id" ? "English" : "Indonesia"}</a>}
        {!gamePage && <><a href="/animals/" hreflang="en">{locale === 'id' ? 'Satwa (EN)' : 'Animals'}</a><a href="/learn/" hreflang="en">{locale === 'id' ? 'Belajar (EN)' : 'Learn'}</a></>}
      </nav>
      {!gamePage && <a class="header-link" href="/about/" hreflang="en">{locale === 'id' ? 'Tentang (EN)' : 'About'}</a>}
    </header>
    <SitePrivacy analyticsId={gaId ?? ""} game={privacy.game} locale={locale} />
    <main id="main-content" tabindex="-1">
      {breadcrumbs.length > 1 && <nav class="site-breadcrumbs" aria-label={locale === 'id' ? 'Jejak navigasi' : 'Breadcrumb'}><ol>{breadcrumbs.map(({ href, name }, i) => <li>{i === breadcrumbs.length - 1 ? <span aria-current="page">{name}</span> : <a href={href}>{name}</a>}</li>)}</ol></nav>}
      <slot />
    </main>
    <footer class="site-footer" lang={locale}><div><a class="brand" href={homePath}><span class="brand-mark">✦</span><span>MyZoo<span class="brand-accent">Twin</span></span></a><p>{ui.tagline}</p></div><div class="footer-links"><a href={homePath}>{ui.home}</a><a href="/play/" data-site-source="home">{ui.play}</a><a href={tutorialPath}>Tutorial</a><a href="/artikel/" hreflang="id">{articlesLabel}</a><a href="/animals/" hreflang="en">{locale === 'id' ? 'Perpustakaan satwa (EN)' : 'Animal library'}</a><a href="/learn/" hreflang="en">{locale === 'id' ? 'Belajar (EN)' : 'Learn'}</a><a href="/about/" hreflang="en">{locale === 'id' ? 'Tentang (EN)' : 'About'}</a></div><small>© {new Date().getFullYear()} MyZooTwin. {ui.footer}<br /><button class="privacy-footer" type="button" data-open-site-privacy disabled>{ui.privacy}</button></small></footer>
  </body>
</html>
<script>
  import {mountSiteEvents} from '../site-events';
  import {mountSitePrivacy} from '../privacy/ui';
  mountSiteEvents(document);
  const privacyRoot = document.querySelector<HTMLElement>('[data-site-privacy]');
  if (privacyRoot) mountSitePrivacy(privacyRoot);
</script>
<style is:global>
.site-breadcrumbs{display:block;padding:.65rem clamp(1.2rem,5vw,5rem);font-size:.85rem;color:var(--muted);background:var(--paper)}.site-breadcrumbs ol{display:flex;flex-wrap:wrap;gap:.25rem .6rem;list-style:none;margin:0;padding:0}.site-breadcrumbs li:not(:first-child)::before{content:'/';padding-right:.6rem;color:var(--line)}.site-breadcrumbs a{text-decoration:underline;text-underline-offset:.18em}.site-breadcrumbs [aria-current]{color:var(--ink)}
.privacy-footer{font:inherit;color:inherit;background:transparent;border:1px solid #adc0b2;border-radius:8px;min-height:44px;padding:.5rem .75rem;margin-top:.75rem;cursor:pointer;white-space:normal}.privacy-footer:disabled{opacity:.6;cursor:default}
.game-reading .site-header nav{flex-wrap:wrap;gap:.35rem 1rem}
.game-reading .site-header nav a{display:inline-flex;align-items:center;min-height:44px}
.game-reading .site-header nav [aria-current="page"]{font-weight:700;text-decoration:underline;text-underline-offset:.3em}


.skip-link{position:absolute;z-index:20;top:.5rem;left:.5rem;transform:translateY(-180%);padding:.75rem 1rem;background:var(--ink);color:white;min-height:44px;border-radius:8px}.skip-link:focus{transform:none}
nav .play-link{font-weight:700;color:var(--forest);white-space:nowrap}nav .play-link[aria-current="page"]{text-decoration:underline;text-decoration-color:var(--gold);text-underline-offset:.4rem}
:root{--gold-text:#805211;--ink:#183b32;--forest:#28594a;--gold:#d89a3e;--cream:#f6f1e7;--paper:#fffdf8;--muted:#64746c;--line:#d8dfd5;font-family:'DM Sans',sans-serif;color:var(--ink);background:var(--paper);line-height:1.6}*{box-sizing:border-box}body{margin:0;background:var(--paper)}a{color:inherit;text-decoration:none}a:focus-visible,button:focus-visible{outline:3px solid var(--gold-text);outline-offset:4px}.site-header{height:80px;display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:0 clamp(1.2rem,5vw,5rem);border-bottom:1px solid rgba(24,59,50,.1);background:rgba(255,253,248,.92);position:relative;z-index:5}.brand{font-weight:700;font-size:1.18rem;letter-spacing:-.04em;display:flex;align-items:center;gap:.55rem}.brand-mark{background:var(--gold);color:var(--ink);width:28px;height:28px;border-radius:50%;display:grid;place-items:center;font-size:.9rem}.brand-accent{color:var(--gold-text)}nav{display:flex;gap:clamp(.85rem,2.2vw,2rem);font-size:.88rem;color:#4d625a}nav a:hover,.header-link:hover{color:var(--gold-text)}.footer-links a:hover{color:#fff}.header-link{font-size:.85rem;font-weight:700}.site-footer{padding:4rem clamp(1.2rem,5vw,5rem) 2rem;background:var(--ink);color:#eef0e5;display:grid;grid-template-columns:1.4fr 1fr auto;gap:3rem;align-items:end}.site-footer .brand{color:white}.site-footer .brand-accent{color:#f4c573}.site-footer :focus-visible{outline-color:#f4c573}.site-footer p{color:#adc0b2;max-width:25rem}.footer-links{display:grid;grid-template-columns:1fr 1fr;gap:.5rem 2rem;color:#c7d4ca;font-size:.9rem}.site-footer small{color:#95aa9e;white-space:nowrap}
h1,h2,h3{font-family:'Playfair Display',serif;line-height:1.05;letter-spacing:-.04em}h1{font-size:clamp(3.3rem,7vw,6.5rem);margin:0}h2{font-size:clamp(2.2rem,4vw,4rem);margin:0}.eyebrow{text-transform:uppercase;letter-spacing:.17em;font-size:.74rem;font-weight:700;color:var(--gold-text)}.button{display:inline-flex;align-items:center;gap:.7rem;background:var(--ink);color:#fff;padding:.9rem 1.35rem;border-radius:999px;font-weight:700;font-size:.9rem}.button:hover{background:var(--forest);transform:translateY(-1px)}.button.secondary{background:transparent;color:var(--ink);border:1px solid var(--ink)}
@media (max-width:820px){.site-header{height:auto;min-height:72px;flex-wrap:wrap;padding-block:1rem}.site-header nav{order:3;width:100%;overflow-x:auto;padding-bottom:.25rem;gap:1.2rem}.header-link{margin-left:auto}.site-footer{grid-template-columns:1fr 1fr}.site-footer small{grid-column:1/-1}}
@media (max-width:520px){.site-header{gap:1rem}.site-header nav{font-size:.8rem}.site-footer{grid-template-columns:1fr;padding-top:3rem}.footer-links{grid-template-columns:1fr 1fr}}
</style>

---
const { title = 'MyZooTwin — Explore. Discover. Understand Animals.', description = 'MyZooTwin is an international animal learning journal for curious people who care about wildlife, pets, and the living world.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://myzootwin.com').toString();
const gaId = import.meta.env.PUBLIC_GA4_ID;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MyZooTwin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    {gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
    {gaId && <script is:inline define:vars={{ gaId }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',gaId);</script>}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="MyZooTwin home"><span class="brand-mark">✦</span><span>MyZoo<span class="brand-accent">Twin</span></span></a>
      <nav aria-label="Main navigation">
        <a href="/animals/">Animals</a><a href="/wildlife/">Wildlife</a><a href="/pets/">Pets</a><a href="/learn/">Learn</a><a href="/adventures/">Adventures</a><a href="/gear/">Gear</a>
      </nav>
      <a class="header-link" href="/about/">About <span aria-hidden="true">↗</span></a>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><div><a class="brand" href="/"><span class="brand-mark">✦</span><span>MyZoo<span class="brand-accent">Twin</span></span></a><p>A curious field guide to the animals we share this planet with.</p></div><div class="footer-links"><a href="/animals/">Animals</a><a href="/wildlife/">Wildlife</a><a href="/pets/">Pets</a><a href="/learn/">Learn</a><a href="/about/">About</a></div><small>© {new Date().getFullYear()} MyZooTwin. Made for curious minds.</small></footer>
  </body>
</html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap');
:root{--ink:#183b32;--forest:#28594a;--gold:#d89a3e;--cream:#f6f1e7;--paper:#fffdf8;--muted:#64746c;--line:#d8dfd5;font-family:'DM Sans',sans-serif;color:var(--ink);background:var(--paper);line-height:1.6}*{box-sizing:border-box}body{margin:0;background:var(--paper)}a{color:inherit;text-decoration:none}a:focus-visible,button:focus-visible{outline:3px solid var(--gold);outline-offset:4px}.site-header{height:80px;display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:0 clamp(1.2rem,5vw,5rem);border-bottom:1px solid rgba(24,59,50,.1);background:rgba(255,253,248,.92);position:relative;z-index:5}.brand{font-weight:700;font-size:1.18rem;letter-spacing:-.04em;display:flex;align-items:center;gap:.55rem}.brand-mark{background:var(--gold);color:var(--ink);width:28px;height:28px;border-radius:50%;display:grid;place-items:center;font-size:.9rem}.brand-accent{color:var(--gold)}nav{display:flex;gap:clamp(.85rem,2.2vw,2rem);font-size:.88rem;color:#4d625a}nav a:hover,.header-link:hover,.footer-links a:hover{color:var(--gold)}.header-link{font-size:.85rem;font-weight:700}.site-footer{padding:4rem clamp(1.2rem,5vw,5rem) 2rem;background:var(--ink);color:#eef0e5;display:grid;grid-template-columns:1.4fr 1fr auto;gap:3rem;align-items:end}.site-footer .brand{color:white}.site-footer p{color:#adc0b2;max-width:25rem}.footer-links{display:grid;grid-template-columns:1fr 1fr;gap:.5rem 2rem;color:#c7d4ca;font-size:.9rem}.site-footer small{color:#95aa9e;white-space:nowrap}
h1,h2,h3{font-family:'Playfair Display',serif;line-height:1.05;letter-spacing:-.04em}h1{font-size:clamp(3.3rem,7vw,6.5rem);margin:0}h2{font-size:clamp(2.2rem,4vw,4rem);margin:0}.eyebrow{text-transform:uppercase;letter-spacing:.17em;font-size:.74rem;font-weight:700;color:var(--gold)}.button{display:inline-flex;align-items:center;gap:.7rem;background:var(--ink);color:#fff;padding:.9rem 1.35rem;border-radius:999px;font-weight:700;font-size:.9rem}.button:hover{background:var(--forest);transform:translateY(-1px)}.button.secondary{background:transparent;color:var(--ink);border:1px solid var(--ink)}
@media (max-width:820px){.site-header{height:auto;min-height:72px;flex-wrap:wrap;padding-block:1rem}.site-header nav{order:3;width:100%;overflow-x:auto;padding-bottom:.25rem;gap:1.2rem}.header-link{margin-left:auto}.site-footer{grid-template-columns:1fr 1fr}.site-footer small{grid-column:1/-1}}
@media (max-width:520px){.site-header{gap:1rem}.site-header nav{font-size:.8rem}.site-footer{grid-template-columns:1fr;padding-top:3rem}.footer-links{grid-template-columns:1fr 1fr}}
</style>
